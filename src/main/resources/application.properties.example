# 복사해서 application.properties 로 사용 (application.properties 는 .gitignore 대상).
# 모든 값은 환경변수로도 덮어쓸 수 있다 (예: SPRING_DATASOURCE_URL, PYTHON_API_URL, REACT_BASE_PATH ...).
spring.application.name=acc
server.port=8081

# --- 외부 서버 ---
python.api.url=http://localhost:5000
accai.base-url=http://localhost:5000

# --- 파일 경로 (절대경로 또는 실행 위치 기준 상대경로) ---
# 생성물 저장 루트 (하위 public/data/promotion/...). 이름과 달리 프론트 레포가 아니어도 된다:
# 브라우저는 /files/{토큰} 으로만 받으므로 vite public 에 둘 필요가 없다 (#27). AI 의 FRONT_PROJECT_ROOT 와 같은 폴더로
react.base-path=../data/local
# AI 전용 내부 파일 API 비밀값 (AI FILES_MODE=http 일 때만, 비우면 꺼짐)
# internal.token=
# AI 서버가 생성한 홍보물은 python.api.url 의 /internal/promotion 으로 받는다 (공유 폴더 불필요)
files.generated-root=./data/promotion/
# 기획서 업로드 저장 위치
files.path=./data/proposal
# 포스터 아카이브 이미지 폴더 (/poster-images/** 로 서빙)
files.poster-images-dir=./홍보물

# --- 인증 (JWT) ---
# 32바이트 이상 임의 문자열. 비우면 기동할 때마다 랜덤 키 (재시작 시 로그인 풀림)
auth.jwt.secret=
auth.jwt.expire-hours=12
# 'test 계정으로 로그인하기' 허용 여부. 기본은 꺼짐, 로컬 개발·시연할 때만 true
auth.test-login.enabled=false
auth.test.email=test@acc.local
# 관리자 계정: 비밀번호(8자 이상)를 주면 최초 기동 시 생성
auth.admin.email=admin@acc.local
auth.admin.password=
# test 계정이 자동 입력에 쓰는 샘플 기획서 폴더 (samples.json + 파일들)
test.samples-dir=./data/samples/proposals

# --- CORS (콤마 구분) ---
cors.allowed-origin-patterns=http://localhost:*,http://127.0.0.1:*

# --- DB ---
spring.datasource.url=jdbc:mysql://localhost:3306/acc_database?serverTimezone=UTC&characterEncoding=UTF-8
spring.datasource.username=
spring.datasource.password=
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# --- DB 마이그레이션 (Flyway) ---
# 기동할 때 src/main/resources/db/migration 의 V*.sql 이 자동 적용된다 (새 DB 도, 이미 테이블이 있는 기존 DB 도 안전).
# baseline 설정은 코드(FlywayConfig)에 이미 들어 있어 따로 적지 않아도 된다. 끄려면:
# spring.flyway.enabled=false

# --- MyBatis ---
mybatis.mapper-locations=classpath:/mappers/**/*.xml
mybatis.type-aliases-package=com.assistant.acc

# --- Multipart ---
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# --- 크레딧 (1 크레딧 ≈ 원가 10원) ---
# 가입 기념 크레딧: 홍보물 전체를 한 번 만들 수 있는 양
credit.signup-bonus=500
# 기능별 차감량 (기본값은 CreditService.COSTS). 바꿀 때만 주석을 푼다
# credit.cost.analyze-proposal=2
# credit.cost.trend=10
# credit.cost.poster-images=80
# credit.cost.mascot-images=30
# credit.cost.regenerate=20
# credit.cost.derivative-basic=5
# credit.cost.derivative-banner=10
# credit.cost.derivative-premium=20
# credit.cost.derivative-video=60
# credit.cost.ai-render=3
# credit.cost.report=1
# credit.cost.live-poster=50

# --- 소셜 로그인 (비우면 해당 버튼이 나오지 않는다) ---
# 각 개발자 콘솔에 Redirect URI 로 {접속 주소}/auth/kakao/callback, {접속 주소}/auth/google/callback 을 등록한다
oauth.kakao.client-id=
oauth.kakao.client-secret=
oauth.google.client-id=
oauth.google.client-secret=
